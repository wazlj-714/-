flowchart TB
    subgraph GUI["GUI / Presentation layer (Qt Widgets)"]
      I["Input adapter: keyboard and QPushButton"]
      V["Widget::paintEvent / QPainter"]
      S["SkinStrategy: Fresh / Retro / Aurora"]
      T["QTimer event driver"]
    end
    subgraph CORE["Independent business layer (C++17, no Qt)"]
      G["Game controller and state machine"]
      SN["Snake: deque of Cell"]
      F["Food: spawn on free cells"]
      R["Leaderboard: map and persistence"]
    end
    I -->|"start / turn / pause / save"| G
    T -->|"tick()"| G
    G --> SN
    G --> F
    G --> R
    V -->|"read-only getters"| G
    G -.->|"change observer and render callback"| V
    V --> S
    classDef gui fill:#e9f5f2,stroke:#2d8f85,color:#22424a;
    classDef core fill:#eef0f9,stroke:#6a7ba9,color:#283853;
    class I,V,S,T gui;
    class G,SN,F,R core;
